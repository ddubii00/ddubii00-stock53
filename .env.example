# Provider policy: auto | kis | naver | krx | demo
# auto = KIS first when credentials exist; otherwise Naver -> optional KRX -> Demo
DATA_PROVIDER=auto
APP_MODE=vercel
PREALERT_PCT=1.0
MIN_AVG_VALUE20=10000000000
MIN_SCORE=55
VERCEL_SCAN_MAX_SYMBOLS=8
FULL_SCAN_WORKERS=8
FUNDAMENTALS_CACHE_DAYS=7
FULL_SCAN_MARKET=ALL
MIN_MARKET_CAP_100M=500
MIN_OPERATING_PROFIT_100M=50
FULL_SCAN_SIGNAL_MODE=actionable
# Optional full-market filters. Set *_ENABLED=0 to remove the filter.
AVG_VALUE10_FILTER_ENABLED=1
MIN_AVG_VALUE10_100M=500
INVESTOR_FILTER_ENABLED=0
INVESTOR_MODE=either
MIN_INVESTOR_NET_BUY_100M=0
TODAY_CHANGE_FILTER_ENABLED=0
MIN_TODAY_CHANGE_PCT=5
FULL_SCAN_INTERVAL_SECONDS=0
ENABLE_KRX_FALLBACK=0
HISTORY_COUNT=260

# Oracle production only. Never commit real values.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_PRODUCT_CODE=01
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_WEBSOCKET_URL=ws://ops.koreainvestment.com:21000/tryitout

# Oracle notification only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# UI realtime polling on Vercel is client-side. Oracle worker interval is server-side.
REALTIME_POLL_SECONDS=30
ORACLE_POLL_SECONDS=20
WATCHLIST=000660,005930,005380,012450,035420
NOTIFY_PROVIDER=none
DB_PATH=./data/turtle.db
POSITION_STORE=sqlite

# Candidate Telegram sizing suggestion defaults.
SIZING_MODE=fixed
FIXED_UNIT_AMOUNT=10000000
ACCOUNT_EQUITY=100000000
RISK_PCT=0.5
